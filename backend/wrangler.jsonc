{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sozcuk-zinciri-online",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": {"enabled": false},
  "vars": {
    "ALLOWED_ORIGINS": "https://ardaisik99.github.io,http://localhost:8060,http://127.0.0.1:8060"
  },
  "durable_objects": {
    "bindings": [
      {"name": "DIRECTORY", "class_name": "Directory"},
      {"name": "ROOMS", "class_name": "GameRoom"}
    ]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Directory", "GameRoom"]}]
}
